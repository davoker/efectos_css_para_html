# EOL de la transicion (verificado por verificar.py): siempre LF en
# disco y en el repo, aunque core.autocrlf=true convierta el resto a
# CRLF al hacer checkout. La portada y los efectos se quedan a cargo
# de autocrlf (CRLF en disco), que es como ya los tiene el repo.
transicion.html text eol=lf
transicion.css text eol=lf
